# Copy to .env (never committed) and fill in. Loaded via environment only — no
# credentials in code, ever (MASTER_SPEC P9; the legacy repo learned this the hard way).

# Interactive Brokers (paper trading; used from T1 on)
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# SEC EDGAR fair-access policy requires a descriptive User-Agent with contact info
EDGAR_USER_AGENT="YourName your@email.com"

# Optional data providers (M1+)
FRED_API_KEY=
